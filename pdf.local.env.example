# Copy this file to pdf.local.env and fill in the real values.
# pdf.local.env is gitignored so that the download URL for the paid PDF
# doesn't appear in the public repo.
PDF_BUCKET=your-bucket-name
PDF_KEY=your-file-name.zip
PDF_ENDPOINT=https://s3.us-west-1.wasabisys.com
PDF_PUBLIC_URL=https://s3.us-west-1.wasabisys.com/your-bucket-name/your-file-name.zip
PDF_SHORTLINK=https://your-short-link
SMARTPHONES_KEY=your-other-file-name.zip
